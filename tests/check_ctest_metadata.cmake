cmake_minimum_required(VERSION 3.21)
find_program(ctest NAMES ctest REQUIRED)
execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}" --show-only=json-v1
  OUTPUT_VARIABLE inventory COMMAND_ERROR_IS_FATAL ANY)
string(JSON count LENGTH "${inventory}" tests)
if(count EQUAL 0)
  message(FATAL_ERROR "CTest inventory is empty")
endif()
math(EXPR last "${count} - 1")
foreach(index RANGE ${last})
  string(JSON name GET "${inventory}" tests ${index} name)
  string(JSON properties GET "${inventory}" tests ${index} properties)
  string(JSON property_count LENGTH "${properties}")
  set(has_timeout FALSE)
  set(has_labels FALSE)
  set(has_ownership_revision FALSE)
  if(property_count GREATER 0)
    math(EXPR property_last "${property_count} - 1")
    foreach(property RANGE ${property_last})
      string(JSON key GET "${properties}" ${property} name)
      string(JSON value GET "${properties}" ${property} value)
      if(key STREQUAL "TIMEOUT" AND value GREATER 0)
        set(has_timeout TRUE)
      elseif(key STREQUAL "LABELS" AND NOT value STREQUAL "[]")
        set(has_labels TRUE)
      elseif(key STREQUAL "ENVIRONMENT")
        string(JSON environment_count LENGTH "${value}")
        if(environment_count GREATER 0)
          math(EXPR environment_last "${environment_count} - 1")
          foreach(entry RANGE ${environment_last})
            string(JSON assignment GET "${value}" ${entry})
            if(assignment STREQUAL "LONEJSON_BENCH_SOURCE_REVISION=ownership-test")
              set(has_ownership_revision TRUE)
            endif()
          endforeach()
        endif()
      endif()
    endforeach()
  endif()
  if(NOT has_timeout OR NOT has_labels)
    message(FATAL_ERROR "${name}: positive TIMEOUT and nonempty LABELS required")
  endif()
  if(name MATCHES "^lonejson_bench_ownership_")
    string(JSON command GET "${inventory}" tests ${index} command 0)
    get_filename_component(executable "${command}" NAME)
    if(NOT executable STREQUAL "lonejson_bench" OR NOT has_ownership_revision)
      message(FATAL_ERROR
        "${name}: Memcheck must execute lonejson_bench directly with revision in ENVIRONMENT")
    endif()
  endif()
endforeach()
if(EXPECT_RUNTIME_TESTS)
  execute_process(COMMAND "${ctest}" --test-dir "${BUILD_DIR}"
    --show-only=json-v1 -LE "host-policy|e2e"
    OUTPUT_VARIABLE runtime COMMAND_ERROR_IS_FATAL ANY)
  string(JSON runtime_count LENGTH "${runtime}" tests)
  if(runtime_count EQUAL 0)
    message(FATAL_ERROR "runtime test selection is empty")
  endif()
  math(EXPR runtime_last "${runtime_count} - 1")
  set(runtime_names "")
  foreach(index RANGE ${runtime_last})
    string(JSON name GET "${runtime}" tests ${index} name)
    list(APPEND runtime_names "${name}")
  endforeach()
  foreach(required IN ITEMS lonejson_tests lonejson_static_link_tests
      lonejson_shared_link_tests lonejson_single_header_strict_warning_tests
      lonejson_header_abi_version_tests)
    if(NOT required IN_LIST runtime_names)
      message(FATAL_ERROR "required target check excluded from runtime selection: ${required}")
    endif()
  endforeach()
  foreach(host_check IN ITEMS lonejson_release_identity_tests
      lonejson_release_archive_verify_tests lonejson_release_checksum_manifest_tests
      lonejson_bench_baseline_history_tests)
    if(host_check IN_LIST runtime_names)
      message(FATAL_ERROR "host policy check leaked into target selection: ${host_check}")
    endif()
  endforeach()
endif()
