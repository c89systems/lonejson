file(MAKE_DIRECTORY "${WORK_DIR}")
set(prefix "extern void consume(void *);\nvoid probe(unsigned n);\nvoid probe(unsigned n) { (void)n;\n")
set(small "${prefix}char data[1024]; consume(data); }\n")
set(large "${prefix}char data[65536]; consume(data); }\n")
set(vla "${prefix}char data[n]; consume(data); }\n")
set(alloca "${prefix}void *data = __builtin_alloca(32); consume(data); }\n")
set(sysroot_option)
if(SYSROOT)
  list(APPEND sysroot_option "--sysroot=${SYSROOT}")
endif()
foreach(case small large vla alloca)
  file(WRITE "${WORK_DIR}/${case}.c" "${${case}}")
  execute_process(COMMAND "${COMPILER}" ${sysroot_option} -std=gnu89 -O0
    -Werror ${STACK_OPTIONS} -c "${WORK_DIR}/${case}.c" -o "${WORK_DIR}/${case}.o"
    RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE diagnostic)
  file(WRITE "${WORK_DIR}/${case}.log" "${output}${diagnostic}")
  if(case STREQUAL "small")
    if(NOT result EQUAL 0)
      message(FATAL_ERROR "small fixed frame failed: ${diagnostic}")
    endif()
  else()
    if(result EQUAL 0)
      message(FATAL_ERROR "${case} unexpectedly compiled with production stack warnings")
    endif()
    if(case STREQUAL "large")
      set(expected "frame")
    else()
      set(expected "${case}")
    endif()
    if(NOT diagnostic MATCHES "${expected}")
      message(FATAL_ERROR "${case} failed for an unrelated reason: ${diagnostic}")
    endif()
  endif()
endforeach()
