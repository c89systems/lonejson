file(READ "${BINARY_DIR}/compile_commands.json" commands)
string(JSON count LENGTH "${commands}")
math(EXPR last "${count} - 1")
set(core_compilations 0)
foreach(index RANGE 0 ${last})
  string(JSON source GET "${commands}" ${index} file)
  if(source STREQUAL "${ROOT}/src/lonejson.c")
    math(EXPR core_compilations "${core_compilations} + 1")
  endif()
endforeach()
if(NOT core_compilations EQUAL 1)
  message(FATAL_ERROR "Expected one core compilation for both libraries, found ${core_compilations}")
endif()
