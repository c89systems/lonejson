get_filename_component(root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(pilot "${WORK_DIR}/bench-pilot.json")
set(corpus "${root}/tests/fixtures/vendor/json_test_suite/test_parsing")
set(case "stream/doc_long_strings/lonejson")
function(round output plan)
  execute_process(COMMAND "${CMAKE_COMMAND}" -E env LONEJSON_BENCH_SOURCE_REVISION=worker-test
    "${BENCH}" round "${corpus}" "${output}" "${plan}" "${case}"
    WORKING_DIRECTORY "${root}" RESULT_VARIABLE status ERROR_VARIABLE diagnostics)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "round failed: ${diagnostics}")
  endif()
endfunction()
round("${pilot}" -)
set(rounds "")
foreach(index RANGE 1 399)
  set(path "${WORK_DIR}/bench-round-${index}.json")
  round("${path}" "${pilot}")
  list(APPEND rounds "${path}")
endforeach()
execute_process(COMMAND "${BENCH}" merge "${WORK_DIR}/bench-worker-result.json"
  "${WORK_DIR}/bench-worker-history.jsonl" "${WORK_DIR}/bench-worker-runs" ${rounds}
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_VARIABLE diagnostics)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "whole-suite collection failed: ${diagnostics}")
endif()
file(READ "${WORK_DIR}/bench-worker-result.json" output)
string(JSON count LENGTH "${output}" results 0 samples)
if(NOT count EQUAL 399)
  message(FATAL_ERROR "expected 399 independent rounds, got ${count}")
endif()
string(JSON planned GET "${output}" results 0 batch_iterations)
foreach(index RANGE 0 398)
  math(EXPR expected_process "${index} + 1")
  string(JSON process GET "${output}" results 0 samples ${index} process_index)
  string(JSON iterations GET "${output}" results 0 samples ${index} iterations)
  string(JSON elapsed GET "${output}" results 0 samples ${index} elapsed_ns)
  if(NOT process EQUAL expected_process OR NOT iterations EQUAL planned OR elapsed LESS 1)
    message(FATAL_ERROR "invalid worker sample ${index}")
  endif()
endforeach()
# A failed/missing last round cannot turn into a successful shorter report.
file(READ "${path}" final_round)
string(JSON different SET "${final_round}" source_src_tree "\"different-source\"")
file(WRITE "${path}" "${different}")
execute_process(COMMAND "${BENCH}" merge "${WORK_DIR}/mixed-source.json"
  "${WORK_DIR}/mixed-source-history.jsonl" "${WORK_DIR}/mixed-source-runs" ${rounds}
  RESULT_VARIABLE mixed_status OUTPUT_QUIET ERROR_QUIET)
if(mixed_status EQUAL 0)
  message(FATAL_ERROR "mixed implementation identities across workers")
endif()
file(WRITE "${path}" "${final_round}")
list(POP_BACK rounds)
execute_process(COMMAND "${BENCH}" merge "${WORK_DIR}/must-not-exist.json"
  "${WORK_DIR}/invalid-history.jsonl" "${WORK_DIR}/invalid-runs" ${rounds}
  RESULT_VARIABLE status OUTPUT_QUIET ERROR_QUIET)
if(status EQUAL 0)
  message(FATAL_ERROR "accepted missing round")
endif()
message(STATUS "Whole-suite workers, excluded pilot, fixed work and complete aggregation passed")
execute_process(COMMAND "${CMAKE_COMMAND}" -E env LONEJSON_BENCH_SOURCE_REVISION=worker-test
  "${BENCH}" round "${corpus}" "${WORK_DIR}/bench-full-round.json" -
  WORKING_DIRECTORY "${root}" RESULT_VARIABLE status ERROR_VARIABLE diagnostics)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "full C round failed: ${diagnostics}")
endif()
file(READ "${WORK_DIR}/bench-full-round.json" full)
string(JSON count LENGTH "${full}" results)
if(NOT count EQUAL 50)
  message(FATAL_ERROR "full C round lost workloads: ${count}")
endif()
set(names "")
foreach(index RANGE 0 49)
  string(JSON name GET "${full}" results ${index} name)
  list(APPEND names "${name}")
endforeach()
file(STRINGS "${root}/bench/workloads.tsv" inventory REGEX "^c[ \t]")
foreach(line IN LISTS inventory)
  string(REGEX REPLACE "^c[ \t]+([^ \t]+).*" "\\1" name "${line}")
  if(NOT name IN_LIST names)
    message(FATAL_ERROR "missing C workload: ${name}")
  endif()
endforeach()
message(STATUS "All 50 C workloads and their correctness checks passed")
