cmake_minimum_required(VERSION 3.25)

if(NOT DEFINED LONEJSON_ROOT)
  message(FATAL_ERROR "LONEJSON_ROOT is required")
endif()
file(REAL_PATH "${LONEJSON_ROOT}" root)
file(READ "${root}/include/lonejson.h" header)
string(REGEX MATCH "#define[ \t]+LONEJSON_ABI_VERSION[ \t]+([0-9]+)" match "${header}")
if(NOT match)
  message(FATAL_ERROR "No numeric LONEJSON_ABI_VERSION in ${root}/include/lonejson.h")
endif()
set(current_abi "${CMAKE_MATCH_1}")

set(release_tag "")
find_package(Git QUIET)
if(Git_FOUND)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" rev-parse --show-toplevel
    RESULT_VARIABLE status OUTPUT_VARIABLE git_root
    OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
  # Source archives nested in a checkout must not borrow the parent's tags.
  if(status EQUAL 0)
    file(REAL_PATH "${git_root}" git_root)
    if(git_root STREQUAL root)
      execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" tag --sort=-version:refname
        RESULT_VARIABLE status OUTPUT_VARIABLE tags ERROR_VARIABLE diagnostic
        OUTPUT_STRIP_TRAILING_WHITESPACE)
      if(NOT status EQUAL 0)
        message(FATAL_ERROR "Cannot list local release tags: ${diagnostic}")
      endif()
      string(REPLACE "\n" ";" tags "${tags}")
      foreach(tag IN LISTS tags)
        if(tag MATCHES "^v[0-9]+\\.[0-9]+\\.[0-9]+$")
          set(release_tag "${tag}")
          break()
        endif()
      endforeach()
    endif()
  endif()
endif()

if(release_tag)
  execute_process(COMMAND "${GIT_EXECUTABLE}" -C "${root}" show "${release_tag}:include/lonejson.h"
    RESULT_VARIABLE status OUTPUT_VARIABLE released_header ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "Cannot read ABI from ${release_tag}: ${diagnostic}")
  endif()
  string(REGEX MATCH "#define[ \t]+LONEJSON_ABI_VERSION[ \t]+([0-9]+)" match "${released_header}")
  if(NOT match)
    message(FATAL_ERROR "No numeric LONEJSON_ABI_VERSION in ${release_tag}")
  endif()
  set(released_abi "${CMAKE_MATCH_1}")
  if(current_abi STREQUAL released_abi)
    message(STATUS "LoneJSON ABI ${current_abi} is unchanged from ${release_tag}; no ABI-triggered downstream upgrade.")
    return()
  endif()
  message(STATUS "LoneJSON ABI ${released_abi} (${release_tag}) -> ${current_abi} (working tree): coordinated downstream upgrade required.")
else()
  message(STATUS "LoneJSON ABI ${current_abi}: release comparison unavailable (no local release history); review downstream compatibility manually.")
endif()

# Curated dependency order, not a downstream build or release controller.
message(STATUS "Downstream upgrade/rebuild order using one LoneJSON ABI across the graph:")
message(STATUS "  1. liblockdc, librotmos: update direct LoneJSON dependencies and rebuild.")
message(STATUS "  2. libcai: update LoneJSON and liblockdc; rebuild.")
message(STATUS "     libailo: update LoneJSON and librotmos; rebuild.")
message(STATUS "  3. vectis: update LoneJSON, liblockdc, libcai, librotmos and libailo; rebuild last.")
message(STATUS "Advisory only: downstream pins, builds and compatibility have not been verified.")
