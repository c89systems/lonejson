file(READ "${POLICY_HEADER}" policy)
string(REGEX MATCH "#define BENCH_MEASUREMENT_METHOD \"([^\"]+)\"" match "${policy}")
set(method "${CMAKE_MATCH_1}")
if(method STREQUAL "")
  message(FATAL_ERROR "cannot read benchmark measurement policy: ${POLICY_HEADER}")
endif()
function(incompatible path reason)
  message(FATAL_ERROR "incompatible benchmark reference: ${path}: ${reason}; remeasure the accepted implementation with the current harness before release")
endfunction()
get_filename_component(policy_dir "${POLICY_HEADER}" DIRECTORY)
file(STRINGS "${policy_dir}/workloads.tsv" budget_lines)
set(budget_names "")
set(budget_values "")
foreach(line IN LISTS budget_lines)
  if(NOT line MATCHES "^[^ \t]+[ \t]+([^ \t]+)[ \t]+([0-9]+)$")
    message(FATAL_ERROR "invalid benchmark case budget: ${line}")
  endif()
  list(APPEND budget_names "${CMAKE_MATCH_1}")
  list(APPEND budget_values "${CMAKE_MATCH_2}")
endforeach()
foreach(path IN ITEMS "${C_BASELINE}" "${LUA_BASELINE}")
  file(READ "${path}" report)
  string(JSON actual ERROR_VARIABLE error GET "${report}" method)
  if(error OR NOT actual STREQUAL method)
    incompatible("${path}" "measurement method differs")
  endif()
  foreach(field source_revision source_src_tree source_include_tree source_lua_tree host compiler toolchain affinity)
    string(JSON actual ERROR_VARIABLE error GET "${report}" "${field}")
    string(JSON type ERROR_VARIABLE type_error TYPE "${report}" "${field}")
    if(error OR type_error OR NOT type STREQUAL "STRING" OR actual STREQUAL "")
      incompatible("${path}" "missing ${field}")
    endif()
  endforeach()
  foreach(field source_revision source_src_tree source_include_tree source_lua_tree implementation_count)
    string(JSON identity GET "${report}" "${field}")
    if(DEFINED identity_${field} AND NOT identity STREQUAL identity_${field})
      incompatible("${path}" "C and Lua ${field} differ")
    endif()
    set(identity_${field} "${identity}")
  endforeach()
  foreach(field source_src_tree source_include_tree source_lua_tree)
    string(LENGTH "${identity_${field}}" identity_length)
    if(NOT identity_${field} MATCHES "^[0-9a-f]+$" OR (NOT identity_length EQUAL 40 AND NOT identity_length EQUAL 64))
      incompatible("${path}" "unversioned ${field}")
    endif()
  endforeach()
  if(identity_source_revision MATCHES ":dirty")
    incompatible("${path}" "uncommitted implementation")
  endif()
  string(JSON count_type TYPE "${report}" implementation_count)
  if(NOT count_type STREQUAL "NUMBER" OR (NOT identity_implementation_count EQUAL 1 AND NOT identity_implementation_count EQUAL 2))
    incompatible("${path}" "invalid implementation count")
  endif()
  foreach(pair
      "sample_count;BENCH_SAMPLE_COUNT" "process_count;BENCH_PROCESS_COUNT"
      "samples_per_process;BENCH_PROCESS_SAMPLE_COUNT" "warmup_count;BENCH_WARMUP_COUNT"
      "target_sample_ns;BENCH_TARGET_SAMPLE_NS" "confidence_pct;BENCH_CONFIDENCE_PCT"
      "max_relative_error_pct;BENCH_MAX_RELATIVE_ERROR_PCT" "max_drift_pct;BENCH_MAX_DRIFT_PCT")
    list(GET pair 0 field)
    list(GET pair 1 macro)
    string(REGEX MATCH "#define ${macro} ([0-9.]+)" match "${policy}")
    set(expected "${CMAKE_MATCH_1}")
    string(JSON actual ERROR_VARIABLE error GET "${report}" "${field}")
    if(error OR expected STREQUAL "" OR NOT actual EQUAL expected)
      incompatible("${path}" "${field} differs")
    endif()
    if(field STREQUAL "sample_count")
      set(sample_count "${expected}")
    endif()
  endforeach()
  string(JSON count ERROR_VARIABLE error LENGTH "${report}" results)
  if(error OR count LESS 1)
    incompatible("${path}" "empty result inventory")
  endif()
  math(EXPR last "${count} - 1")
  foreach(index RANGE 0 ${last})
    string(JSON result GET "${report}" results ${index})
    string(JSON name ERROR_VARIABLE name_error GET "${result}" name)
    string(JSON case_budget ERROR_VARIABLE budget_error GET "${result}" target_sample_ns)
    if(name_error OR budget_error OR NOT case_budget GREATER 0)
      incompatible("${path}" "missing case budget")
    endif()
    if(name MATCHES "/cjson$")
      string(REGEX MATCH "#define BENCH_TARGET_SAMPLE_NS ([0-9]+)" match "${policy}")
      set(expected_budget "${CMAKE_MATCH_1}")
    else()
      list(FIND budget_names "${name}" budget_index)
      if(budget_index LESS 0)
        incompatible("${path}" "unknown case ${name}")
      endif()
      list(GET budget_values ${budget_index} expected_budget)
    endif()
    if(NOT case_budget EQUAL expected_budget)
      incompatible("${path}" "case budget differs: ${name}")
    endif()
    string(JSON samples ERROR_VARIABLE error LENGTH "${result}" samples)
    if(error OR NOT samples EQUAL sample_count)
      incompatible("${path}" "missing raw samples")
    endif()
    string(JSON name ERROR_VARIABLE name_error GET "${result}" name)
    set(informational FALSE)
    if(NOT name_error AND name MATCHES "/cjson$")
      set(informational TRUE)
    endif()
    foreach(field mismatch_count cv_pct drift_pct relative_error_pct)
      string(JSON value ERROR_VARIABLE error GET "${result}" "${field}")
      string(JSON type ERROR_VARIABLE type_error TYPE "${result}" "${field}")
      if(error OR type_error OR NOT type STREQUAL "NUMBER" OR value LESS 0)
        incompatible("${path}" "invalid ${field}")
      endif()
      if(field STREQUAL "mismatch_count")
        if(NOT value EQUAL 0)
          incompatible("${path}" "correctness failures")
        endif()
      elseif(field STREQUAL "relative_error_pct")
        string(JSON limit GET "${report}" "max_${field}")
        if(NOT informational AND value GREATER limit)
          incompatible("${path}" "imprecise ${field}")
        endif()
      endif()
    endforeach()
    foreach(field drift_ci_low_pct drift_ci_high_pct mib_per_sec_low mib_per_sec_high)
      string(JSON value ERROR_VARIABLE error GET "${result}" "${field}")
      string(JSON type ERROR_VARIABLE type_error TYPE "${result}" "${field}")
      if(error OR type_error OR NOT type STREQUAL "NUMBER")
        incompatible("${path}" "invalid ${field}")
      endif()
      if(field MATCHES "^mib_per_sec_" AND NOT value GREATER 0)
        incompatible("${path}" "invalid ${field}")
      endif()
      if(field STREQUAL "drift_ci_low_pct")
        string(JSON limit GET "${report}" max_drift_pct)
        if(NOT informational AND value GREATER limit)
          incompatible("${path}" "confirmed drift")
        endif()
      elseif(field STREQUAL "drift_ci_high_pct")
        string(JSON limit GET "${report}" max_drift_pct)
        string(REGEX REPLACE "^-" "" magnitude "${value}")
        if(NOT informational AND value LESS 0 AND magnitude GREATER limit)
          incompatible("${path}" "confirmed drift")
        endif()
      endif()
    endforeach()
  endforeach()
endforeach()
message(STATUS "Frozen benchmark references match the current measurement policy")
message(STATUS "Benchmark reference source: ${identity_source_revision}")
message(STATUS "Benchmark reference src tree: ${identity_source_src_tree}")
message(STATUS "Benchmark reference include tree: ${identity_source_include_tree}")
message(STATUS "Benchmark reference lua tree: ${identity_source_lua_tree}")
if(DEFINED REFERENCE_INFO_DIR)
  file(MAKE_DIRECTORY "${REFERENCE_INFO_DIR}")
  foreach(field source_revision source_src_tree source_include_tree source_lua_tree)
    file(WRITE "${REFERENCE_INFO_DIR}/${field}" "${identity_${field}}")
  endforeach()
endif()
